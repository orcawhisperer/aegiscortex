# Optional live Jev. Set this in Vercel → Project Settings → Environment Variables
# for Production / Preview. Never commit a real key.
TYPESAFE_API_KEY=

# Local Gin bind. 127.0.0.1:8090 is only the default when none of these are set.
# Vercel injects PORT and the backend listens on :$PORT (all interfaces).
# AEGIS_ADDR=127.0.0.1:8090
# AEGIS_PORT=8090

# Next.js SSR origin for the Gin service (local). On Vercel this is
# BACKEND_INTERNAL_URL from the service binding in vercel.json — do not
# hardcode 127.0.0.1 there.
# AEGIS_BACKEND_URL=http://127.0.0.1:8090
